# 统一换行符：文本文件仓库内与检出后均为 LF，杜绝 LF/CRLF 混杂与 autocrlf 警告
* text=auto eol=lf

# Windows 专属脚本保持 CRLF（PowerShell 5.1 / cmd 的习惯格式）
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件，禁止任何转换
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
